# Postgres (el esquema "lukita" viene de ../Lukita-BD.sql)
DATABASE_URL="postgresql://usuario:password@localhost:5432/lukita?schema=lukita"

PORT=4000

# Usar un valor largo y aleatorio distinto en cada entorno.
JWT_SECRET="cambia-esto-por-un-secreto-largo"
JWT_EXPIRES_IN="7d"

# Azure AI Foundry - modelo con vision para "foto a gasto" (Hito 2).
# Se activan con el credito de Azure for Students. Mientras no esten
# configuradas, /api/recibos/analizar responde con datos de prueba.
AZURE_FOUNDRY_ENDPOINT=""
AZURE_FOUNDRY_API_KEY=""
AZURE_FOUNDRY_DEPLOYMENT=""
