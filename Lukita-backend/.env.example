# Postgres (el esquema "lukita" viene de ../Lukita-BD.sql)
DATABASE_URL="postgresql://usuario:password@localhost:5432/lukita?schema=lukita"

PORT=4000

# Usar un valor largo y aleatorio distinto en cada entorno.
JWT_SECRET="cambia-esto-por-un-secreto-largo"
JWT_EXPIRES_IN="7d"

# Lector de boletas "vision-aula"
VISION_AULA_URL="https://boletas-aula.analizodatos.com/v1/boleta"
VISION_AULA_TOKEN=""

# Groq (console.groq.com): free tier sin tarjeta, limitado por rate-limit.
# Mientras no este configurado, /api/perfiles/:perfilId/voz responde con
# datos de prueba.
GROQ_API_KEY=""
# GROQ_WHISPER_MODEL="whisper-large-v3-turbo"
# GROQ_LLM_MODEL="openai/gpt-oss-120b"

# Azure Speech (texto a voz para "Preguntale a Lukita"). Mientras no este
# configurado, /chat/hablar responde 503 y el frontend cae al
# speechSynthesis gratis del navegador.
AZURE_SPEECH_KEY=""
AZURE_SPEECH_REGION=""
# AZURE_SPEECH_VOICE="es-PE-CamilaNeural"
